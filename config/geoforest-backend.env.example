NODE_ENV=production
PORT=3001
LOCAL_DATA_ROOT=/media/server/HD Backup/Servidores_NAO_MEXA/Banco_de_dados/GeoForest

GROQ_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

SEMA_WMS_BASE_URL=https://geo.sema.mt.gov.br/geoserver/ows
SEMA_WMS_AUTHKEY=541085de-9a2e-454e-bdba-eb3d57a2f492

# SIGEF — geometria de parcela (WFS INCRA por padrão)
SIGEF_WFS_BASE_URL=https://acervofundiario.incra.gov.br/i3geo/ogc.php?tema=certificada_sigef_particular_mt
SIGEF_WFS_TYPENAME=certificada_sigef_particular_mt
SIGEF_WFS_TIMEOUT_MS=120000
# Futuro: API Conecta Gov / SERPRO (deixar vazio até ter Consumer Key/Secret)
SIGEF_SERPRO_BASE_URL=
SIGEF_SERPRO_CONSUMER_KEY=
SIGEF_SERPRO_CONSUMER_SECRET=
SIGEF_SERPRO_TOKEN_URL=

# CAR Federal (SICAR) — WFS por UF (MT padrão)
SICAR_WFS_BASE_URL=https://geoserver.car.gov.br/geoserver/sicar/ows
SICAR_WFS_LAYER=sicar:sicar_imoveis_mt
# Camadas CAR estadual (SEMA-MT) usadas na análise de sobreposição
SEMA_CAR_ATP_WFS_LAYER=Geoportal:CAR_ATP
SEMA_CAR_REQUIRED_WFS_LAYER=Geoportal:MVW_REQUERIMENTO_ATP

# Croqui de acesso (roteamento viário OSRM)
CROQUI_OSRM_BASE_URL=https://router.project-osrm.org

PRODES_WFS_URL=https://terrabrasilis.dpi.inpe.br/geoserver/ows
PRODES_LAYER=prodes-legal-amz:yearly_deforestation
PRODES_YEAR_FIELD=year

SFB_WFS_URL=https://geo.sema.mt.gov.br/geoserver/wfs
SFB_RIVER_LAYER=Geoportal:SFB_HIDRO_TRECHO_DRENAGEM
SFB_WFS_AUTHKEY=541085de-9a2e-454e-bdba-eb3d57a2f492

# Oráculo SIMCAR (valores reais somente no env do servidor; nunca commitar credenciais)
# Sem SIMCAR_CPF/SIMCAR_SENHA o backend não muta nada (não existe mais PROCESSAR_MODE).
SIMCAR_CPF=
SIMCAR_SENHA=
DEEPSEEK_API_KEY=
SIMCAR_TEST_CAR_ID=271442
SIMCAR_POLL_MS=5000
SIMCAR_IMPORT_TIMEOUT_MS=900000
SIMCAR_PROCESS_TIMEOUT_MS=1800000
SIMCAR_BASEREF_TIMEOUT_MS=1200000
SIMCAR_ABRANGENCIA_MARGIN_M=500

# --- CBERS / GeoServer / WMS ---
# Os valores abaixo sao os DEFAULTS embutidos no codigo (servidor do WMS). So precisam ser
# definidos aqui para sobrescrever em outro host. Rode scripts/cbers-doctor.sh para validar.
# Acervo permanente dos GeoTIFFs (HD de 2 TB):
CBERS_ARCHIVE_ROOT=/media/server/HD Backup/RASTER/CBERS_4A
# GeoServer local (REST usada para publicacao automatica) e WMS publico:
GEOSERVER_BASE_URL=http://127.0.0.1:8081/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=cbers
GEOSERVER_DATA_DIR=/home/server/geoserver_data
GEOSERVER_EXTERNAL_CBRS_ROOT=/home/server/.local/geoserver-work/data_dir/external/cbers
GEOSERVER_PUBLIC_WMS_BASE=https://wms.cursar.space/geoserver/cbers/wms
GEOSERVER_RASTER_STYLE=raster
# Realce de contraste 8 bits da imagem gerada:
#   global  (padrao) clareia/contrasta SEM mudar o balanco de cor (preserva o 342 verde)
#   perband contraste maximo, mas muda a cor (falsa-cor magenta/verde)
#   minmax  comportamento antigo (min..max absoluto, escuro)
# Aumente o sigma para um realce mais suave (corta menos a cauda clara).
CBERS_STRETCH_MODE=global
CBERS_STRETCH_SIGMA=2.5
CBERS_STRETCH_APPROX=1
# Piramides de overview do GeoTIFF publicado (zoom-out mais suave no WMS):
CBERS_OVERVIEW_RESAMPLING=average
# Robustez da publicacao quando o GeoServer reinicia (deploy):
GEOSERVER_PUBLISH_RETRIES=4
GEOSERVER_PUBLISH_RETRY_DELAY_MS=4000
GEOSERVER_READY_TIMEOUT_MS=60000

# --- Croqui de acesso (ATP -> PDF/DOCX/KML) ---
# Base do mapa do PDF. Com a chave, usa Google Static Maps (maptype=hybrid), que traz
# os rotulos de cidade e escudos de rodovia dos croquis modelo. Sem ela, cai para o
# Esri World Imagery: imagem parecida, porem sem rotulos.
GOOGLE_STATIC_MAPS_KEY=
# Roteamento viario. O router.project-osrm.org e servidor de demonstracao (sem SLA).
CROQUI_OSRM_BASE_URL=https://router.project-osrm.org
CROQUI_OSRM_RETRIES=3
# Trechos menores que isso viram parte do trecho anterior no roteiro.
CROQUI_MIN_STEP_M=300

# --- NDVI (pos-recorte) ---
# Fase de NDVI atras de flag, igual as 3 fases pos-recorte: desligada responde
# 409 PHASE_NOT_READY. Ligar e decisao consciente (ver NDVI/Plano de implementacao/).
SIMCAR_NDVI_ENABLED=false
# Acervo dos GeoTIFF NDVI (irmao de RASTER/CBERS_4A e RASTER/LANDSAT):
NDVI_ARCHIVE_ROOT=/media/server/HD Backup/RASTER/NDVI
NDVI_TMP_ROOT=/tmp/geoforest-ndvi
# Escolha de cena: miolo da seca em MT, marco de 22/07.
NDVI_SEASON_START=06-01
NDVI_SEASON_END=09-30
NDVI_MAX_CLOUD_PCT=40
# Coeficientes radiometricos do Landsat C2 L2 (rho = DN*escala + offset).
# NAO mexer para "ajustar" resultado: existem para o dia em que a USGS publicar
# colecao com outros coeficientes. O offset NAO cancela na razao do NDVI.
NDVI_SR_SCALE=0.0000275
NDVI_SR_OFFSET=-0.2
NDVI_NODATA=-9999
# Bits do QA_PIXEL que viram nodata: fill+dilated+cloud+shadow+snow (59).
# Agua (bit 7) fica de fora de proposito: agua e informacao (NDVI < 0).
NDVI_QA_MASK_BITS=59
# Estatistica zonal (uma linha por feicao, nunca pela uniao):
NDVI_ZONAL_MAX_FEATURES=50
NDVI_MIN_VALID_PCT=0.6
NDVI_MIN_PIXELS=10
# Publicacao no GeoServer (biblioteca NDVI dentro de RASTER):
GEOSERVER_NDVI_STYLE=ndvi_ramp
# Float32 usa nearest: average misturaria nodata -9999 com dado valido.
NDVI_OVERVIEW_RESAMPLING_DATA=nearest
NDVI_OVERVIEW_RESAMPLING_RGB=average
